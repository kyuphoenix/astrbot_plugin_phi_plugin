{
  "default_global": {
    "description": "默认使用国际服存档接口",
    "type": "bool",
    "default": false
  },
  "render_mode": {
    "description": "渲染模式；image 使用 AstrBot HTML/Playwright 图片面板，text 返回纯文本",
    "type": "string",
    "default": "image",
    "options": ["text", "image"]
  },
  "render_backend": {
    "description": "图片渲染后端；当前固定使用 AstrBot HTML/Playwright 渲染",
    "type": "string",
    "default": "html",
    "options": ["html"]
  },
  "max_b30": {
    "description": "B30 展示条数",
    "type": "int",
    "default": 33,
    "slider": {"min": 33, "max": 50, "step": 1}
  },
  "api_base_url": {
    "description": "Phi Plugin 联合查分 API 地址",
    "type": "string",
    "default": "https://phib19.top:8080"
  },
  "request_timeout": {
    "description": "网络请求超时时间（秒）",
    "type": "int",
    "default": 10,
    "slider": {"min": 3, "max": 60, "step": 1}
  },
  "qrcode_timeout": {
    "description": "TapTap 二维码登录等待时间（秒）",
    "type": "int",
    "default": 270,
    "slider": {"min": 30, "max": 600, "step": 10}
  },
  "github_proxy": {
    "description": "GitHub 代理地址，当前仅预留",
    "type": "string",
    "default": ""
  }
}
